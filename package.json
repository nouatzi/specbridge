{
  "name": "@ipation/specbridge",
  "version": "3.0.0",
  "description": "Architecture Decision Runtime - Transform architectural decisions into executable, verifiable constraints",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "specbridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "npm run test:integration:core && npm run test:integration:cli",
    "test:integration:core": "vitest run --config vitest.integration.core.config.ts",
    "test:integration:cli": "vitest run --config vitest.integration.cli.config.ts",
    "test:integration:cli:smoke": "vitest run --config vitest.integration.cli.config.ts tests/integration/cli/smoke.test.ts",
    "test:integration:cli:core": "vitest run --config vitest.integration.cli.config.ts tests/integration/cli/init-verify.test.ts tests/integration/cli/infer-decision.test.ts",
    "test:integration:cli:aux": "vitest run --config vitest.integration.cli.config.ts tests/integration/cli/hook-report-context.test.ts tests/integration/cli/errors.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docs:validate": "node scripts/docs/validate-runtime-policy.mjs",
    "release:validate": "node scripts/release/validate-version-changelog.mjs",
    "architecture:check-boundaries": "node scripts/maintenance/check-module-boundaries.mjs",
    "architecture:check-boundaries:warning": "node scripts/maintenance/check-module-boundaries.mjs --mode=warning",
    "eslint10:readiness": "npm_config_cache=.cache/npm node scripts/maintenance/check-eslint10-readiness.mjs",
    "eslint10:readiness:strict": "npm_config_cache=.cache/npm node scripts/maintenance/check-eslint10-readiness.mjs --strict",
    "coverage:check-modules": "node scripts/maintenance/check-module-coverage.mjs",
    "type-check": "tsc --noEmit",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "docs": "typedoc --out docs/api src/index.ts",
    "docs:serve": "npm run docs && npx http-server docs/api",
    "pack:check": "npm_config_cache=.cache/npm npm pack --ignore-scripts && npm_config_cache=.cache/npm HUSKY=0 npm pack --dry-run",
    "deps:outdated": "npm_config_cache=.cache/npm npm outdated --long",
    "health:quick": "npm run type-check && npm run lint:check && npm run format:check && npm run test:unit",
    "health:check": "npm run docs:validate && npm run release:validate && npm run type-check && npm run lint:check && npm run format:check && npm run test && npm run test:integration && npm run test:coverage && npm run coverage:check-modules && npm audit --audit-level=high && npm audit --omit=dev --audit-level=moderate",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "architecture",
    "adr",
    "architectural-decisions",
    "constraints",
    "verification",
    "code-quality",
    "cli",
    "typescript",
    "governance",
    "decision-records"
  ],
  "homepage": "https://github.com/nouatzi/specbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nouatzi/specbridge.git"
  },
  "bugs": {
    "url": "https://github.com/nouatzi/specbridge/issues"
  },
  "author": "SpecBridge Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.0",
    "minimatch": "^10.2.5",
    "ora": "^9.4.1",
    "pino": "^10.3.1",
    "table": "^6.8.0",
    "ts-morph": "^27.0.2",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.0.0",
    "prettier": "^3.9.5",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
