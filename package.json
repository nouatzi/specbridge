{
  "name": "@ipation/specbridge",
  "version": "1.1.1",
  "description": "Architecture Decision Runtime - Transform architectural decisions into executable, verifiable constraints",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "specbridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "docs": "typedoc --out docs/api src/index.ts",
    "docs:serve": "npm run docs && npx http-server docs/api",
    "prepare": "husky install",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "architecture",
    "adr",
    "architectural-decisions",
    "constraints",
    "verification",
    "code-quality",
    "cli",
    "typescript",
    "governance",
    "decision-records"
  ],
  "homepage": "https://github.com/nouatzi/specbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nouatzi/specbridge.git"
  },
  "bugs": {
    "url": "https://github.com/nouatzi/specbridge/issues"
  },
  "author": "SpecBridge Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.0",
    "minimatch": "^9.0.0",
    "ora": "^8.0.0",
    "table": "^6.8.0",
    "ts-morph": "^24.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.8",
    "yaml": "^2.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
