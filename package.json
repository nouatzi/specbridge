{
  "name": "@ipation/specbridge",
  "version": "2.4.1",
  "description": "Architecture Decision Runtime - Transform architectural decisions into executable, verifiable constraints",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "specbridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "npm run test:integration:core && npm run test:integration:cli",
    "test:integration:core": "vitest run --config vitest.integration.core.config.ts",
    "test:integration:cli": "vitest run --config vitest.integration.cli.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "docs": "typedoc --out docs/api src/index.ts",
    "docs:serve": "npm run docs && npx http-server docs/api",
    "pack:check": "npm_config_cache=.cache/npm npm pack --ignore-scripts && npm_config_cache=.cache/npm HUSKY=0 npm pack --dry-run",
    "health:check": "npm run type-check && npm run lint:check && npm run format:check && npm run test && npm run test:integration && npm run test:coverage && npm audit --audit-level=high",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "architecture",
    "adr",
    "architectural-decisions",
    "constraints",
    "verification",
    "code-quality",
    "cli",
    "typescript",
    "governance",
    "decision-records"
  ],
  "homepage": "https://github.com/nouatzi/specbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nouatzi/specbridge.git"
  },
  "bugs": {
    "url": "https://github.com/nouatzi/specbridge/issues"
  },
  "author": "SpecBridge Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.0",
    "minimatch": "^10.1.2",
    "ora": "^9.3.0",
    "pino": "^9.9.5",
    "table": "^6.8.0",
    "ts-morph": "^27.0.2",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.8",
    "yaml": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
